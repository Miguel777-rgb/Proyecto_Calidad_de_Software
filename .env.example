# ==========================================================================
# OLA — Observatorio Litoral de Anomalías térmicas
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas el archivo `.env` al repositorio: contiene secretos reales.
# ==========================================================================

# --- Puertos publicados en el equipo local -------------------------------
# Cámbialos si alguno choca con un servicio que ya tengas corriendo.
WEB_PORT=5173
API_PORT=8000
DB_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
UPTIME_KUMA_PORT=3001

# --- Base de datos PostgreSQL --------------------------------------------
POSTGRES_USER=ola
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=ola

# Cadena de conexión que usa el backend. El host `db` es el nombre del
# servicio dentro de la red de Docker Compose.
OLA_DATABASE_URL=postgresql+psycopg://ola:cambia_esta_clave@db:5432/ola

# --- Seguridad (RF-07) ----------------------------------------------------
# Genera uno propio con: openssl rand -hex 32
OLA_JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_de_64_caracteres
OLA_JWT_ALGORITHM=HS256
OLA_ACCESS_TOKEN_MINUTES=60
# Límite de intentos contra la fuerza bruta: superarlo responde 429 durante la
# ventana. Fallos de inicio de sesión por cuenta y por IP; solicitudes de código
# y códigos equivocados de recuperación por IP.
OLA_RATE_LIMIT_WINDOW_MINUTES=15
OLA_LOGIN_FAILURES_PER_ACCOUNT=5
OLA_LOGIN_FAILURES_PER_IP=20
OLA_PASSWORD_RESET_REQUESTS_PER_IP=10
OLA_PASSWORD_RESET_FAILURES_PER_IP=20

# --- Administrador inicial ------------------------------------------------
# Se crea automáticamente al arrancar el backend, solo si aún no existe.
OLA_ADMIN_EMAIL=admin@ola.pe
OLA_ADMIN_PASSWORD=cambia_esta_clave_de_admin

# --- Reglas de dominio (RF-01, RF-02) -------------------------------------
# Valores por defecto; el administrador puede cambiarlos desde la aplicación.
OLA_THRESHOLD_C=0.5
OLA_MIN_STREAK_RECORDS=5
OLA_MAX_GAP_DAYS=2
OLA_FRESHNESS_DAYS=7
OLA_PROJECTION_WINDOW_DAYS=30
OLA_PROJECTION_HORIZON_DAYS=5

# --- Correo (RF-03) -------------------------------------------------------
# En local apunta a Mailpit, que captura los correos sin enviarlos afuera.
OLA_SMTP_HOST=mailpit
OLA_SMTP_PORT=1025
OLA_SMTP_USER=
OLA_SMTP_PASSWORD=
OLA_SMTP_TLS=false
OLA_MAIL_FROM=alertas@ola.pe

# --- Tareas programadas (RF-03, RF-08) -----------------------------------
# Las ejecuta el servicio `scheduler` (en local: docker compose --profile tareas up -d).
# Cada cuántos minutos se envían los avisos pendientes y se reintentan los fallidos;
# 0 desactiva el envío automático.
OLA_SCHEDULER_SEND_MINUTES=10
# Importación automática del CSV de IMARPE. Vacía, queda desactivada y la carga
# sigue siendo manual. Si el archivo no cambió, no se registra otra importación.
OLA_IMPORT_URL=
OLA_IMPORT_EVERY_HOURS=24

# --- Aplicación -----------------------------------------------------------
OLA_ENV=development
OLA_LOG_LEVEL=INFO
OLA_CORS_ORIGINS=http://localhost:5173

# URL de la API que consume el navegador. En producción se sirve detrás del
# mismo dominio, por lo que basta la ruta relativa `/api`.
VITE_API_URL=/api

# --- Calidad: disponibilidad con Uptime Kuma ------------------------------
# Cuenta local del panel http://localhost:3001. La crea
# `docker compose --profile calidad run --rm calidad configurar.py`.
UPTIME_KUMA_USUARIO=calidad
UPTIME_KUMA_CLAVE=cambia_esta_clave_de_uptime_kuma
# Opcional: dirección del sistema desplegado. Si está definida, configurar.py
# crea un segundo monitor sobre su /api/health/ready.
OLA_VPS_URL=

# ==========================================================================
# PRODUCCIÓN (Dokploy)
# ==========================================================================
# Estas variables NO van en un archivo en el servidor: se definen en la
# interfaz de Dokploy, que las inyecta en los contenedores. Se listan aquí
# solo como referencia de qué hay que configurar.
#
# Además de las de arriba (POSTGRES_*, OLA_JWT_SECRET, OLA_ADMIN_*, OLA_SMTP_*)
# el despliegue necesita:

# Web y API comparten un dominio y se separan por ruta. No hay variables de
# dominio: se configura en la pestaña Domains de Dokploy, donde /api va al
# servicio `api` (puerto 8000) y / al servicio `web` (puerto 80).

# Dirección de la API que usará el navegador. Al compartir dominio basta la
# ruta relativa. Vite la escribe DENTRO del JavaScript al construir la imagen:
# cambiarla exige reconstruir, no basta con reiniciar el contenedor.
# OLA_API_URL=/api

# Origen permitido para CORS: el dominio de la web, con su esquema y sin barra
# final. Como la web llama a la API en su mismo dominio el navegador no lo
# necesita; se mantiene por si otro origen consume la API.
# OLA_WEB_ORIGIN=https://ola.tudominio.pe

# En producción la aplicación SE NIEGA A ARRANCAR si OLA_JWT_SECRET tiene
# menos de 32 bytes o conserva el valor de esta plantilla. Genera uno con:
#   openssl rand -hex 32
# OLA_ENV=production
