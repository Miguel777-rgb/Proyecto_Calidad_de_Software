# Nombres cortos para las carpetas de node_modules/.pnpm. Con los nombres
# largos por defecto, la compilacion nativa de la app Android en Windows
# llegaba a rutas de 295 caracteres y CMake no podia ejecutar sus scripts
# (el limite para ejecutar un .bat sigue siendo 260). Ver decisiones.md, 18.1.
virtual-store-dir-max-length=40
