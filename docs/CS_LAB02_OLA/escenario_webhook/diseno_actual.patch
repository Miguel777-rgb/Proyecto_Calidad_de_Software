index 0000000..6e7723d
--- /dev/null
+++ b/backend/src/ola/webhook.py
@@ -0,0 +1,49 @@
+"""Entrega de avisos a una pasarela de mensajeria externa (webhook).
+
+La pasarela recibe cada aviso como JSON en una peticion HTTP POST y se
+encarga de hacerlo llegar al destinatario. Su URL se define en el .env con
+OLA_WEBHOOK_URL; sin ella, la entrega falla y el aviso queda para reintentar.
+"""
+
+from __future__ import annotations
+
+import json
+import urllib.request
+from dataclasses import asdict, dataclass
+from typing import Protocol
+
+
+@dataclass(frozen=True)
+class WebhookMessage:
+    recipient: str
+    subject: str
+    body: str
+
+
+class WebhookSender(Protocol):
+    def send(self, message: WebhookMessage) -> None: ...
+
+
+class WebhookNotConfiguredError(RuntimeError):
+    def __init__(self) -> None:
+        super().__init__("La pasarela no esta configurada (OLA_WEBHOOK_URL).")
+
+
+class HttpWebhookSender:
+    """Envia por HTTP POST. Lanza la excepcion si falla; quien llama la registra."""
+
+    def __init__(self, url: str, *, timeout: float = 15) -> None:
+        self._url = url
+        self._timeout = timeout
+
+    def send(self, message: WebhookMessage) -> None:
+        if not self._url:
+            raise WebhookNotConfiguredError
+        peticion = urllib.request.Request(
+            self._url,
+            data=json.dumps(asdict(message)).encode("utf-8"),
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        with urllib.request.urlopen(peticion, timeout=self._timeout):
+            pass
