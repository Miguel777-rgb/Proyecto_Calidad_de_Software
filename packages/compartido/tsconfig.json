{
  "compilerOptions": {
    "target": "ES2022",
    // DOM aporta solo los tipos de fetch, Response y FormData, que tambien
    // existen en React Native. El paquete no toca el documento.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": []
  },
  "include": ["src", "vitest.config.ts"]
}
